/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# Η αυτόματη εικόνα κάθε αγγελίας (αυτή που βλέπει ο κόσμος στο Facebook).
# Το Next τη γράφει ως αρχείο ΧΩΡΙΣ κατάληξη .png, οπότε ο server δεν μπορεί να
# μαντέψει τι είναι — και επειδή πιο πάνω δηλώνουμε «nosniff», το Facebook θα
# την πετούσε. Εδώ το δηλώνουμε ρητά. Μέσα σε αυτούς τους φακέλους δεν υπάρχει
# τίποτε άλλο εκτός από την εικόνα, οπότε ο κανόνας δεν αγγίζει άλλο αρχείο.
/jobs/:id/*
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Τα εικονίδια ΔΕΝ κρατιούνται για έναν χρόνο, όσο κι αν μπαίνει ο πειρασμός.
#
# Τα αρχεία κάτω από /_next/static/ έχουν τυχαίο κωδικό στο όνομά τους: κάθε νέα
# έκδοση βγάζει ΝΕΟ όνομα, οπότε «για πάντα» είναι σωστό. Τα εικονίδια όμως έχουν
# πάντα το ίδιο όνομα. Με «immutable» ο browser δεν ξαναρωτάει καν αν άλλαξαν.
#
# Αυτό μας το έκανε κιόλας: αλλάξαμε το λογότυπο, ανέβηκε κανονικά, και το
# staffnow.gr/icon-512.png συνέχιζε να δίνει το παλιό — ηλικίας 16 ημερών.
# Με μία ώρα, κάθε μελλοντική αλλαγή λογοτύπου φτάνει σε όλους μέσα στην ώρα.
/icon-*.png
  Cache-Control: public, max-age=3600

/icon.svg
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/favicon-*.png
  Cache-Control: public, max-age=3600
