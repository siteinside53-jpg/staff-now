{
  // Ο έλεγχος ύφους δεν είχε ποτέ ρύθμιση — γι' αυτό ρωτούσε και κολλούσε.
  "extends": "next/core-web-vitals",
  "rules": {
    // Ο κανόνας αυτός θεωρεί λάθος την απόστροφο μέσα σε κείμενο. Στα ελληνικά
    // τη χρησιμοποιούμε κανονικά (π.χ. «Δωρεάν εγγραφή σε 30''»). Εμφανίζεται
    // σωστά στον browser· δεν αλλάζω κείμενο που βλέπει ο πελάτης για χάρη του.
    "react/no-unescaped-entities": "off"
  }
}
